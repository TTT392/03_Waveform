 142:Core/Src/main.c ****     oled_ok = 1;
 143:Core/Src/main.c ****   }
 144:Core/Src/main.c **** 
 145:Core/Src/main.c ****   if (oled_ok)
 146:Core/Src/main.c ****   {
 147:Core/Src/main.c ****     OLED_init();//初始化屏幕
