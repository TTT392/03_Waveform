 148:Core/Src/main.c ****     OLED_operate_gram(PEN_CLEAR);//清空屏幕
 149:Core/Src/main.c ****     OLED_show_string(1,1,(uint8_t*)"Sine");
 150:Core/Src/main.c ****     OLED_refresh_gram();//刷新到屏幕
 151:Core/Src/main.c ****   }
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****   HAL_TIM_Base_Start_IT(&htim2);//启动定时器2
