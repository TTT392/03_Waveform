 157:Core/Src/main.c **** 
 158:Core/Src/main.c ****   /* Infinite loop */
 159:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 160:Core/Src/main.c ****   while (1)
 161:Core/Src/main.c ****   {
 162:Core/Src/main.c ****     /* USER CODE END WHILE */
 163:Core/Src/main.c **** 
 164:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 165:Core/Src/main.c **** if(rx_flag==1){
 166:Core/Src/main.c ****   rx_flag=0;
 167:Core/Src/main.c ****   time_count =0;
 168:Core/Src/main.c ****   if (oled_ok)
 169:Core/Src/main.c ****   {
 170:Core/Src/main.c ****     OLED_operate_gram(PEN_CLEAR);//处理中断
 171:Core/Src/main.c ****     if(current_wave=='1'){
 172:Core/Src/main.c ****       OLED_show_string(1,1,(uint8_t*)"Sine");
 173:Core/Src/main.c ****     }else if(current_wave=='2'){
 174:Core/Src/main.c ****       OLED_show_string(1,1,(uint8_t*)"Sawtooth");
 175:Core/Src/main.c ****     }else if(current_wave=='3'){
 176:Core/Src/main.c ****       OLED_show_string(1,1,(uint8_t*)"Square");
 177:Core/Src/main.c ****     }
 178:Core/Src/main.c ****     OLED_refresh_gram();//刷新屏幕
 179:Core/Src/main.c ****   }
 180:Core/Src/main.c **** 
 181:Core/Src/main.c **** }
 182:Core/Src/main.c **** //定时器对应变量
 183:Core/Src/main.c **** if(update_flag ==1){
 184:Core/Src/main.c ****   update_flag =0;
 185:Core/Src/main.c **** 
 186:Core/Src/main.c ****   float t = time_count/1000.0f;//把毫秒换算成秒
 187:Core/Src/main.c ****   float y =0.0f;//存放结果
 188:Core/Src/main.c **** 
 189:Core/Src/main.c ****   if(current_wave=='1'){
 190:Core/Src/main.c ****     y =2.0f*sinf(2.0f*3.1415926f*t);
 191:Core/Src/main.c ****   }
 192:Core/Src/main.c ****   //锯齿波
 193:Core/Src/main.c ****   else if(current_wave =='2'){
 194:Core/Src/main.c ****     float ph =fmodf(t,0.5f)/0.5f;//周期
 195:Core/Src/main.c ****     y = 2.0f*ph-1.0f;//好麻烦，但是用f转化位浮点数算起来更快
 196:Core/Src/main.c ****   }
 197:Core/Src/main.c ****   else if(current_wave =='3')
 198:Core/Src/main.c ****   {
 199:Core/Src/main.c ****     float ph =fmodf(t,1.5f);
 200:Core/Src/main.c ****     if(ph <0.75f){
 201:Core/Src/main.c ****       y =0.5f;
 202:Core/Src/main.c ****     }else{
 203:Core/Src/main.c ****       y = -0.5f;
 204:Core/Src/main.c ****     }
ARM GAS  C:\Users\31217\AppData\Local\Temp\ccEPvo5S.s 			page 5


 205:Core/Src/main.c ****     
 206:Core/Src/main.c ****     
 207:Core/Src/main.c ****   }
 208:Core/Src/main.c ****    Send_VOFA_Float(y);
 209:Core/Src/main.c **** }
 210:Core/Src/main.c **** 
 211:Core/Src/main.c ****   }
 212:Core/Src/main.c ****   /* USER CODE END 3 */
 213:Core/Src/main.c **** }
