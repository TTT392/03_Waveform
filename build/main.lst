 133:Core/Src/main.c ****   // 探测 OLED 地址：0x78 或 0x7A，哪个应答就用哪个；都没有就跳过显示
 134:Core/Src/main.c ****   if (HAL_I2C_IsDeviceReady(&hi2c1, 0x78, 3, 50) == HAL_OK)
 135:Core/Src/main.c ****   {
 136:Core/Src/main.c ****     OLED_I2C_ADDRESS = 0x78;
 137:Core/Src/main.c ****     oled_ok = 1;
 138:Core/Src/main.c ****   }
 139:Core/Src/main.c ****   else if (HAL_I2C_IsDeviceReady(&hi2c1, 0x7A, 3, 50) == HAL_OK)
 140:Core/Src/main.c ****   {
