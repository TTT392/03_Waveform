  91:Core/Src/main.c ****   tx_buf[6] = 0x80;
  92:Core/Src/main.c ****   tx_buf[7] = 0x7f;
  93:Core/Src/main.c ****   //函数与外界交互，把数据发出去
  94:Core/Src/main.c ****   HAL_UART_Transmit(&huart1,tx_buf,8,100);
  95:Core/Src/main.c **** 
  96:Core/Src/main.c **** }
